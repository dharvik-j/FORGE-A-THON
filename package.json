{
  "name": "forge-agent",
  "displayName": "FORGE — Editor-Native Coding Agent",
  "description": "A coding agent for VS Code whose agent loop runs on TrueForge. Budgeted context retrieval, multi-file edits with per-hunk review, streaming, cancellation and automatic model fallback.",
  "version": "0.1.0",
  "publisher": "forge-athon",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dharvik-j/FORGE-A-THON"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22.14"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forge",
          "title": "FORGE",
          "icon": "media/forge.svg"
        }
      ]
    },
    "views": {
      "forge": [
        {
          "type": "webview",
          "id": "forge.agentView",
          "name": "Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "forge.inlineEdit",
        "title": "FORGE: Inline Edit Selection",
        "category": "FORGE"
      },
      {
        "command": "forge.openAgent",
        "title": "FORGE: Open Agent Panel",
        "category": "FORGE"
      },
      {
        "command": "forge.cancel",
        "title": "FORGE: Cancel Run",
        "category": "FORGE"
      },
      {
        "command": "forge.undoLastApply",
        "title": "FORGE: Undo Last Apply",
        "category": "FORGE"
      },
      {
        "command": "forge.setup",
        "title": "FORGE: Set up TrueForge (models, agents, MCP connector)",
        "category": "FORGE"
      },
      {
        "command": "forge.openSession",
        "title": "FORGE: Open TrueForge Session",
        "category": "FORGE"
      },
      {
        "command": "forge.showOutput",
        "title": "FORGE: Show Log",
        "category": "FORGE"
      }
    ],
    "keybindings": [
      {
        "command": "forge.inlineEdit",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "forge.cancel",
        "key": "ctrl+alt+escape",
        "mac": "cmd+alt+escape"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "forge.inlineEdit",
          "when": "editorHasSelection",
          "group": "1_modification@0"
        }
      ]
    },
    "configuration": {
      "title": "FORGE",
      "properties": {
        "forge.trueforgeUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Base URL of the local TrueForge server."
        },
        "forge.mcpPort": {
          "type": "number",
          "default": 3917,
          "description": "Port for the workspace MCP server FORGE serves to TrueForge on 127.0.0.1."
        },
        "forge.primaryAgent": {
          "type": "string",
          "default": "forge-coder",
          "description": "Saved TrueForge agent used for every run."
        },
        "forge.fallbackAgent": {
          "type": "string",
          "default": "forge-coder-fallback",
          "description": "Saved TrueForge agent (on a different model) used automatically when the primary fails with a model/provider error. Leave empty to disable."
        },
        "forge.primaryModel": {
          "type": "string",
          "default": "",
          "description": "Model FQN (provider/model) for the primary agent; written by “FORGE: Set up TrueForge”."
        },
        "forge.fallbackModel": {
          "type": "string",
          "default": "",
          "description": "Model FQN for the fallback agent; written by “FORGE: Set up TrueForge”."
        },
        "forge.contextBudgetTokens": {
          "type": "number",
          "default": 6000,
          "minimum": 500,
          "maximum": 24000,
          "description": "Approximate token budget for code excerpts returned by retrieve_context."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository",
    "setup:trueforge": "node dist/forge-cli.js setup",
    "forge": "node dist/forge-cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "0.185.0",
    "diff": "^9.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
